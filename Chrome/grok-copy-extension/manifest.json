{
  "manifest_version": 3,
  "name": "Grok 回复批量复制",
  "version": "1.0",
  "description": "在 Grok 页面从上到下依次点击每条回复的复制按钮，配合剪贴板监听使用",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/*",
        "https://x.com/i/grok*"
      ],
      "js": ["content.js"],
      "css": ["button.css"],
      "run_at": "document_idle"
    }
  ]
}
